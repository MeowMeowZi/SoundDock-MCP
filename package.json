{
  "name": "sounddock-mcp",
  "version": "0.1.0",
  "description": "AI-callable sound effects, music and narration through a local MCP server",
  "type": "module",
  "private": true,
  "engines": { "node": ">=24.0.0" },
  "repository": { "type": "git", "url": "https://github.com/MeowMeowZi/SoundDock-MCP.git" },
